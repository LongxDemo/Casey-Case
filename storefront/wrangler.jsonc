{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casey-case",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [
    { "pattern": "caseycase.design", "custom_domain": true },
    { "pattern": "www.caseycase.design", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
